@*
  Application layout for Razor Pages.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style1.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" />
    @* Link Swiper's CSS *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>

        a.navbar-brand {
          white-space: normal;
          text-align: center;
          word-break: break-all;
        }

        a {
          color: #0077cc;
        }

        .btn-primary {
          color: #fff;
          background-color: #1b6ec2;
          border-color: #1861ac;
        }

        .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
          color: #fff;
          background-color: #1b6ec2;
          border-color: #1861ac;
        }

        .border-top {
          border-top: 1px solid #e5e5e5;
        }
        .border-bottom {
          border-bottom: 1px solid #e5e5e5;
        }

        .box-shadow {
          box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .05);
        }

        button.accept-policy {
          font-size: 1rem;
          line-height: inherit;
        }

        .footer {
          position: absolute;
          bottom: 0;
          width: 100%;
          white-space: nowrap;
          line-height: 60px;
        }

        header {
    width: 100%;
    background: #fff;
    padding: 10px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    }

    .navbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        gap: 25px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .navbar li a {
        text-decoration: none;
        color: #333;
        font-weight: 600;
    }

    .LogoLeft {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        padding: 6px 10px;
        border-radius: 10px;
        transition: 0.3s ease;
    }

    .LogoLeft i {
        font-size: 42px;
        color: var(--accent-color);
        text-shadow: 0 0 8px rgba(0, 200, 255, 0.4);
    }

    .LogoLeft span {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: 1px;
        color: var(--primary-color);
    }

    .LogoLeft:hover {
        transform: scale(1.06);
        background: rgba(0, 123, 255, 0.12);
    }

    .LogoLeft:hover span {
        color: var(--secondary-color);
    }

    .LogoLeft:hover i {
        color: var(--primary-color);
        text-shadow: 0 0 10px rgba(0, 123, 255, 0.6);
    }

    .profile {
        display: flex;
        align-items: center;
        column-gap: 0.5rem;
        cursor: pointer;
        position: relative; /* Phải có */
    }

    .profile-dropdown {
        position: absolute;
       top: 100%;
        right: 0;
        width: 150px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.2);
        list-style: none;
        padding: 8px 0;
        display: none;
        z-index: 2000;
    }

        .profile-dropdown li {
            padding: 10px 15px;
        }

            .profile-dropdown li a {
                color: #333;
                text-decoration: none;
                display: block;
            }

            .profile-dropdown li:hover {
                background: #f2f2f2;
            }

            .profile-dropdown.active {
                display: block;
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <header>
        <a asp-controller="Home" asp-action="Home" class="LogoLeft">
            <i class='bx bx-microchip'></i>
            <span>PC MASTER</span>
        </a>
           <!-- Menu Icon-->
        <div class="bx bx-menu" id="menu-icon"></div>
        <!-- Nav List-->
        <ul class="navbar">
            <li>
                <a asp-controller="Home" asp-action="ProductManagement"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ProductManagement" ? "home-active" : "")">
                    Product Management
                </a>
            </li>

            <li>
                <a asp-controller="Home" asp-action="CategoryManagement"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "CategoryManagement" ? "home-active" : "")">
                    Category Management
                </a>
            </li>

           <li>
                <a asp-controller="Home" asp-action="UserManagement"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "UserManagement" ? "home-active" : "")">
                    User Management
                </a>
            </li>

       </ul>

        <!-- Profile -->
        <div class="profile" id="profileMenu">
            <img src="~/img/pfp.webp" alt="" />
            <span>Admin</span>
            <i class='bx bx-caret-down'></i>

            <!-- Dropdown -->
            <ul class="profile-dropdown" id="profileDropdown">
                <li><a asp-controller="Home" asp-action="Home">User</a></li>
                <li><a asp-controller="Home" asp-action="Login">Đăng xuất</a></li>
            </ul>
        </div>
        </header>
   
    

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        const profileMenu = document.getElementById("profileMenu");
        const dropdown = document.getElementById("profileDropdown");

        profileMenu.addEventListener("click", function () {
            dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
        });

        // Ẩn dropdown khi click ra ngoài
        document.addEventListener("click", function (event) {
            if (!profileMenu.contains(event.target)) {
                dropdown.style.display = "none";
            }
        });
</script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

