@{
    Layout = "_Layout";
    ViewData["Title"] = "Notification Page";
}

<style>
:root {
    --primary-color: #007BFF;
    --secondary-color: #0056B3;
    --accent-color: #00C8FF;
    --bg-color: #F5F6FA;
    --text-color: #212529;
    --light-text-color: #6C757D;
    --success-color: #28A745;
    --fail-color: #DC3545;
}

/* NEW HOVER STYLE */
.noti-box {
    transition: all 0.3s ease;
    cursor: pointer;
    border-left: 5px solid transparent;
}

.noti-box:hover {
    background-color: var(--bg-color);
    transform: translateY(-4px);
    box-shadow: 0 6px 14px rgba(0,0,0,0.18);
    border-left: 5px solid var(--accent-color);
}

/* Action buttons */
.notification-actions {
    margin-top: 20px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}


.btn-read, .btn-delete {
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    transition: 0.3s ease;
    font-weight: 600;
}

.btn-read {
    background: var(--success-color);
    color: white;
}

.btn-read:hover {
    background: #1f8a3a;
}

.btn-delete {
    background: var(--fail-color);  
    color: white;
}

.btn-delete:hover {
    background: #b52a36;
}
</style>


<section class="notification-page" style="padding:40px 0; max-width:900px; margin:auto;">
    <h1 style="text-align:center; margin-bottom:30px; font-size:2.4rem;">Thông báo từ cửa hàng</h1>

    <div class="noti-box" style="background:#fff; padding:20px; margin-bottom:20px; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
        <h2 style="margin-bottom:5px;">📦 Hàng mới về</h2>
        <p style="margin:0; color:#444;">Chúng tôi vừa cập nhật thêm nhiều sản phẩm linh kiện PC mới nhất như GPU RTX, CPU Ryzen và các mẫu bàn phím cơ cao cấp.</p>
        <span style="font-size:0.9rem; color:#888;">Ngày đăng: 12/11/2025</span>
    </div>

    <div class="noti-box" style="background:#fff; padding:20px; margin-bottom:20px; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
        <h2 style="margin-bottom:5px;">🚚 Cập nhật dịch vụ giao hàng</h2>
        <p style="margin:0; color:#444;">Shop đã hỗ trợ giao hàng nhanh trong ngày tại khu vực TP.HCM và giao tiêu chuẩn toàn quốc.</p>
        <span style="font-size:0.9rem; color:#888;">Ngày đăng: 10/11/2025</span>
    </div>

    <div class="noti-box" style="background:#fff; padding:20px; margin-bottom:20px; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
        <h2 style="margin-bottom:5px;">💳 Đơn hàng của bạn đã được thanh toán</h2>
        <p style="margin:0; color:#444;">Một số đơn hàng sử dụng ví Momo hoặc chuyển khoản ngân hàng đã được xác nhận thanh toán tự động.</p>
        <span style="font-size:0.9rem; color:#888;">Ngày đăng: 07/11/2025</span>
    </div>

    <div class="noti-box" style="background:#fff; padding:20px; margin-bottom:20px; border-radius:10px; box-shadow:0 2px 6px rgba(0,0,0,0.15);">
        <h2 style="margin-bottom:5px;">🎉 Khuyến mãi Black Friday</h2>
        <p style="margin:0; color:#444;">Giảm giá lên đến 50% cho combo PC, chuột gaming và router WiFi cao cấp. Thời gian có hạn!</p>
        <span style="font-size:0.9rem; color:#888;">Ngày đăng: 01/11/2025</span>
    </div>
</section>

<div class="notification-actions">
    <button class="btn-read">Đánh dấu tất cả là đã đọc</button>
    <button class="btn-delete">Xoá tất cả thông báo</button>
</div>
