
@{
    Layout = "_Layout";
    ViewData["Title"] = "Product Detail";

    // Lấy id từ query string
    int id = 0;
    string idStr = Context.Request.Query["id"];
    if (!string.IsNullOrEmpty(idStr))
    {
        int.TryParse(idStr, out id);
    }

    // Danh sách sản phẩm mẫu
    var products = new List<dynamic>
    {
        new { Id = 1, Img="~/img/linh-kien-roi/gpu1.png", Cat="linh-kien-roi", Name="CPU AMD Ryzen 5 5600X", Price="5.000.000", Discount="-10%", Desc="CPU 6 nhân 12 luồng, mạnh mẽ cho gaming và làm việc.", Performance="Tốc độ: 3.7GHz, Turbo 4.6GHz", Rating="4.5/5" },
        new { Id = 2, Img="~/img/combo-pc/sinh-vien.jpg", Cat="combo-pc", Name="Combo PC dành cho sinh viên", Price="25.000.000", Discount="-20%", Desc="Combo PC đầy đủ, phù hợp học tập và giải trí.", Performance="CPU: i5, RAM: 16GB, SSD: 512GB", Rating="4.7/5" },
        new { Id = 3, Img="~/img/thiet-bi-ngoai-vi/keyboard1.jpg", Cat="thiet-bi-ngoai-vi", Name="Bàn phím Razer BlackWidow V3", Price="3.500.000", Discount="-5%", Desc="Bàn phím cơ chất lượng, led RGB.", Performance="Switch: Green, Key rollover: 100%", Rating="4.6/5" },
        new { Id = 4, Img="~/img/thiet-bi-mang/router1.png", Cat="thiet-bi-mang", Name="Router WiFi 6 TP-Link AX50", Price="2.000.000", Discount="-30%", Desc="Router chuẩn WiFi 6, tốc độ cao, băng thông lớn.", Performance="Tốc độ 3Gbps, 4 anten", Rating="4.4/5" },
        new { Id = 5, Img="~/img/phu-kien-pc/bo-ve-sinh.jpg", Cat="phu-kien-pc", Name="Bộ vệ sinh chuyên dụng", Price="130.000", Discount="-30%", Desc="Bộ vệ sinh chuyên dụng cho PC và laptop.", Performance="Chất lượng cao, tiện lợi", Rating="4.2/5" },
        new { Id = 6, Img="~/img/linh-kien-roi/mainboard1.jpg", Cat="linh-kien-roi", Name="Mainboard MSI B450 Tomahawk", Price="4.130.000", Discount="-10%", Desc="Mainboard AM4, hỗ trợ Ryzen 3/5/7.", Performance="DDR4 4133MHz, PCIe 3.0", Rating="4.5/5" },
        new { Id = 7, Img="~/img/linh-kien-roi/cooling2.jpg", Cat="linh-kien-roi", Name="Quạt tản nhiệt NZXT AIO", Price="3.500.000", Discount="-20%", Desc="Tản nhiệt nước AIO, yên tĩnh và hiệu quả.", Performance="120mm radiator, PWM", Rating="4.3/5" },
        new { Id = 8, Img="~/img/thiet-bi-mang/modem1.jpg", Cat="thiet-bi-mang", Name="Modem Viettel H640W", Price="950.000", Discount="-25%", Desc="Modem hỗ trợ FTTH, dễ dàng cấu hình.", Performance="WiFi AC, tốc độ 1Gbps", Rating="4.1/5" },
        new { Id = 9, Img="~/img/thiet-bi-ngoai-vi/mouse1.jpg", Cat="thiet-bi-ngoai-vi", Name="Chuột Gaming Razer Viper", Price="550.000", Discount="-15%", Desc="Chuôt cỡ chống mỏi tay, linh hoạt", Performance="Chất lượng cao", Rating="4.5/5" },
        new { Id = 10, Img="~/img/phu-kien-pc/cap-ket-noi1.jpg", Cat="phu-kien-pc", Name="12VHPWR (RTX 40xx)", Price="650.000", Discount="-10%", Desc="Kết nối nhanh, vỏ cứng cáp chống cong dây", Performance="Chất lượng cao", Rating="4.9/5" },
    };

    // Lấy sản phẩm theo ID
    var product = products.FirstOrDefault(p => p.Id == id);
}

@section Styles {
    <link rel="stylesheet" href="~/css/style1.css" />
    <style>
        .product-detail {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            margin: 20px 0;
            justify-content: center;
        }

        .product-detail img {
            max-width: 400px;
            width: 100%;
            border-radius: 8px;
        }

        .product-info {
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .product-info h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .product-info h2 {
            color: #ff0000;
            margin: 5px 0;
        }

        .product-info span,
        .product-info p {
            display: block;
            margin: 5px 0;
            line-height: 1.5;
        }

        .back-btn {
            margin-top: 20px;
            display: inline-block;
            text-decoration: none;
            color: #fff;
            background: #333;
            padding: 10px 20px;
            border-radius: 5px;
            transition: 0.3s;
        }

        .back-btn:hover {
            background: #fff;
        }
    </style>
}

@if (product == null)
{
    <h2>Không tìm thấy sản phẩm!</h2>
    <a href="/Home/product" class="back-btn">Quay lại danh sách sản phẩm</a>
}
else
{
    <section class="product-detail">
        <img src="@Url.Content(product.Img)" alt="@product.Name" />
        <div class="product-info">
            <h1>@product.Name</h1>
            <h2>@product.Price VNĐ <span style="color:green;">@product.Discount</span></h2>
            <p>@product.Desc</p>
            <span><strong>Danh mục:</strong> @product.Cat.Replace("-", " ")</span>
            <span><strong>Hiệu suất:</strong> @product.Performance</span>
            <span><strong>Đánh giá:</strong> @product.Rating</span>

            <a href="/Home/product" class="back-btn">Quay lại danh sách sản phẩm</a>
        </div>
    </section>
}

<script src="~/js/site.js"></script>
