@{
    Layout = "_Layout";
    ViewData["Title"] = "Cart Page";

    // Giỏ hàng mẫu (sau này thay bằng Model hoặc Session)
    var cartItems = new List<dynamic>
    {
        new { Id = 1, Img="~/img/linh-kien-roi/gpu1.png", Name="GPU RTX 4060", Price=7500000, Qty=1 },
        new { Id = 2, Img="~/img/combo-pc/sinh-vien.jpg", Name="Combo PC Sinh viên", Price=12500000, Qty=2 },
    };
}

<style>
    :root {
        --primary-color: #007BFF;
        --secondary-color: #0056B3;
        --accent-color: #00C8FF;
        --bg-color: #F5F6FA;
        --text-color: #212529;
        --light-text-color: #6C757D;
        --success-color: #28A745;
        --fail-color: #DC3545;
    }

    .cart-container {
        max-width: 1000px;
        margin: 40px auto;
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    }

    .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr 150px 150px;
    align-items: center;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid #ddd;
}


    .cart-item img {
        width: 90px;
        border-radius: 10px;
    }

    .qty-box {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
    }

    .btn-qty {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--primary-color);
        color: white;
        border: none;
        cursor: pointer;
        font-size: 18px;
        transition: 0.2s;
    }

    .btn-qty:hover {
        background: var(--secondary-color);
    }

    .qty-display {
        width: 40px;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
    }

    .item-total {
        width: 100%;
        text-align: right;
        font-size: 18px;
        font-weight: bold;
        color: var(--accent-color);
        white-space: nowrap;
    }

    .cart-total-box {
        margin-top: 25px;
        text-align: right;
        font-size: 24px;
        font-weight: bold;
        color: var(--primary-color);
    }

    .btn-checkout {
        margin-top: 15px;
        padding: 12px 25px;
        background: var(--success-color);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 18px;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-checkout:hover {
        background: #1f8a3a;
    }
</style>

<div class="cart-container">
    <h1 style="text-align:center; margin-bottom:20px;">🛒 Giỏ hàng của bạn</h1>

    <div id="cart-list">
        @foreach (var item in cartItems)
        {
            <div class="cart-item" data-id="@item.Id" data-price="@item.Price">
                <img src="@Url.Content(item.Img)" />

                <div>
                    <h3>@item.Name</h3>
                    <p style="color:var(--light-text-color);">@String.Format("{0:n0}", item.Price) VNĐ</p>
                </div>

                <div class="qty-box">
                    <button class="btn-qty btn-minus">-</button>
                    <span class="qty-display">@item.Qty</span>
                    <button class="btn-qty btn-plus">+</button>
                </div>

                <div class="item-total">
                    @String.Format("{0:n0}", item.Price * item.Qty) VNĐ
                </div>
            </div>
        }
    </div>

    <div class="cart-total-box">
        Tổng cộng: <span id="cart-total">0</span> VNĐ
    </div>

    <form method="post" action="/CheckOut/SaveCart">
        <input type="hidden" name="cartData" id="cartData" />
        <button type="submit" class="btn-checkout">Thanh toán ngay</button>
    </form>

</div>

<script>
    function updateTotal() {
        let total = 0;

        document.querySelectorAll('.cart-item').forEach(item => {
            let price = parseInt(item.dataset.price);
            let qty = parseInt(item.querySelector('.qty-display').textContent);
            let itemTotal = price * qty;

            item.querySelector('.item-total').textContent = itemTotal.toLocaleString() + " VNĐ";
            total += itemTotal;
        });

        document.getElementById('cart-total').textContent = total.toLocaleString();
    }

    document.querySelectorAll('.btn-plus').forEach(btn => {
        btn.addEventListener('click', function () {
            let qtyDisplay = this.previousElementSibling;
            qtyDisplay.textContent = parseInt(qtyDisplay.textContent) + 1;
            updateTotal();
        });
    });

    document.querySelectorAll('.btn-minus').forEach(btn => {
        btn.addEventListener('click', function () {
            let qtyDisplay = this.nextElementSibling;
            let qty = parseInt(qtyDisplay.textContent);
            if (qty > 1) qtyDisplay.textContent = qty - 1;
            updateTotal();
        });
    });

    const form = document.querySelector('form');
    form.addEventListener('submit', function(e){
        const cart = [];
        document.querySelectorAll('.cart-item').forEach(item => {
           cart.push({
                Id: item.dataset.id,
                Name: item.querySelector("h3").innerText,
                Image: item.querySelector("img").src,
                Price: parseInt(item.dataset.price),
                Quantity: parseInt(item.querySelector('.qty-display').textContent)
            });
        });
        document.getElementById('cartData').value = JSON.stringify(cart);
    });

    // Initial calculation
    updateTotal();
</script>

