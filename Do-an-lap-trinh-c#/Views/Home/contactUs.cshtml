@{
    ViewData["Title"] = "Contact Us Page";
}

<style>
    :root {
        --primary-color: #007BFF;
        --secondary-color: #0056B3;
        --accent-color: #00C8FF;
        --bg-color: #F5F6FA;
        --text-color: #212529;
        --light-text-color: #6C757D;
        --success-color: #28A745;
        --fail-color: #DC3545;
    }

    body {
        background: var(--bg-color);
        font-family: 'Poppins', sans-serif;
    }

    .contact-container {
        width: 100%;
        padding: 50px 0;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact-box {
        width: 85%;
        background: white;
        border-radius: 20px;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        overflow: hidden;
        box-shadow: 0px 8px 25px rgba(0,0,0,0.1);
    }

    .contact-info {
        background: var(--primary-color);
        padding: 40px;
        color: white;
    }

    .contact-info h2 {
        font-size: 32px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .info-item {
        margin: 25px 0;
        font-size: 17px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .info-item i {
        font-size: 22px;
    }

    .contact-form {
        padding: 40px 50px;
        display: flex;
        flex-direction: column;
    }

    .contact-form h2 {
        font-size: 28px;
        margin-bottom: 10px;
        color: var(--secondary-color);
    }

    .contact-form p {
        color: var(--light-text-color);
        margin-bottom: 30px;
    }

    .contact-form .input-group {
        margin-bottom: 20px;
    }

    .contact-form input,
    .contact-form textarea {
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        border: 1px solid #DDD;
        outline: none;
        transition: 0.3s;
        font-size: 15px;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 6px rgba(0,123,255,0.3);
    }

    .contact-form button {
        padding: 14px;
        background: var(--primary-color);
        border: none;
        color: white;
        font-size: 17px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: 0.3s;
        width: max-content;
    }

    .contact-form button:hover {
        background: var(--secondary-color);
        transform: translateY(-2px);
    }
</style>
<br>
<br>
<br>
<br>
<div class="contact-container">
    <div class="contact-box">

        <!-- LEFT SIDE -->
        <div class="contact-info">
            <h2>Liên hệ với chúng tôi</h2>

            <div class="info-item">
                <i class='bx bx-map'></i>
                <span>123 Nguyễn Văn Cừ, Q.5, TP.HCM</span>
            </div>

            <div class="info-item">
                <i class='bx bx-phone-call'></i>
                <span>+84 909 999 888</span>
            </div>

            <div class="info-item">
                <i class='bx bx-envelope'></i>
                <span>support@pcshop.vn</span>
            </div>

            <div class="info-item">
                <i class='bx bx-time-five'></i>
                <span>08:00 - 21:00 (T2 - CN)</span>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="contact-form">
            <form method="post" action="/Home/ContactSuccess">

                <div class="input-group">
                    <input type="text" name="name" placeholder="Họ và tên" required>
                </div>

                <div class="input-group">
                    <input type="email" name="email" placeholder="Email" required>
                </div>

                <div class="input-group">
                    <textarea name="message" rows="5" placeholder="Nội dung liên hệ..." required></textarea>
                </div>

                <button type="submit">
                    Gửi ngay <i class='bx bx-right-arrow-alt'></i>
                </button>

            </form>
        </div>
    </div>
</div>

