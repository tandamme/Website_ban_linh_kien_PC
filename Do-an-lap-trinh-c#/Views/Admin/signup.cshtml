@{
    ViewData["Title"] = "Signup";
    Layout = null;
}

@model Do_an_lap_trinh_c_.ViewModels.RegisterVM
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <!-- Import lại Bootstrap hoặc CSS của bạn -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Import file style chính -->
    <link rel="stylesheet" href="~/css/style1.css" />

    <!-- Import icon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" />
</head>

<body>

   <div class="auth-container">
    <div class="auth-box">
        <h2>Đăng ký</h2>

        <form asp-controller="User" asp-action="Register" method="post">
            <label>Tên người dùng</label>
            <input asp-for="userName" class="auth-input" placeholder="Nhập tên người dùng" />
            <span asp-validation-for="userName" class="text-danger"></span>

            <label>Email</label>
            <input asp-for="email" type="email" class="auth-input" placeholder="Nhập email" />
            <span asp-validation-for="email" class="text-danger"></span>

            <label>Mật khẩu</label>
            <input asp-for="passWord" type="password" class="auth-input" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="passWord" class="text-danger"></span>

            <label>Nhập lại mật khẩu</label>
            <input asp-for="rePassWord" type="password" class="auth-input" placeholder="Xác nhận mật khẩu" />
            <span asp-validation-for="rePassWord" class="text-danger"></span>

            <button type="submit" class="auth-btn">Đăng ký</button>
        </form>

        <p class="auth-text">
            Đã có tài khoản?
            <a asp-controller="Home" asp-action="Login">Đăng nhập ngay</a>
        </p>
    </div>
</div>

</body>
</html>


<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f5f5f5;
    }

    .auth-box {
        width: 360px;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.1);
        animation: fadeIn 0.3s ease;
    }

    .auth-box h2 {
        text-align: center;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .auth-input {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 12px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 15px;
    }

    .auth-btn {
        width: 100%;
        padding: 10px;
        background: #28a745;
        border: none;
        border-radius: 6px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

    .auth-btn:hover {
        background: #218838;
    }

    .auth-text {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

    .auth-text a {
        color: #007bff;
        text-decoration: none;
        font-weight: 600;
    }

</style>
