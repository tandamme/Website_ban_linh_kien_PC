@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style1.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" />
</head>

<body>
<div class="auth-container">
    <div class="auth-box">
        <h2>Đăng nhập</h2>

        <!-- CHỈ 1 FORM -->
        <form asp-controller="Home" asp-action="Index" method="post">

            <label>Email</label>
            <input type="email" name="email" class="auth-input" placeholder="Nhập email" required>

            <label>Mật khẩu</label>
            <input type="password" name="password" class="auth-input" placeholder="Nhập mật khẩu" required>

            <button type="submit" class="auth-btn">Đăng nhập</button>
        </form>

        <p class="auth-text">
            Chưa có tài khoản?
            <a asp-controller="Home" asp-action="Signup">Đăng ký ngay</a>
        </p>
    </div>
</div>
</body>
</html>


<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f5f5f5;
    }

    .auth-box {
        width: 360px;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.1);
        animation: fadeIn 0.3s ease;
    }

    .auth-box h2 {
        text-align: center;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .auth-input {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 12px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 15px;
    }

    .auth-btn {
        width: 100%;
        padding: 10px;
        background: #007bff;
        border: none;
        border-radius: 6px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

    .auth-btn:hover {
        background: #0069d9;
    }

    .auth-text {
        text-align: center;
        margin-top: 15px;
        font-size: 14px;
    }

    .auth-text a {
        color: #007bff;
        text-decoration: none;
        font-weight: 600;
    }

</style>

