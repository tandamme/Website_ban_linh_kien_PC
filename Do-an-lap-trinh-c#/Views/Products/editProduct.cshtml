@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="add-container">
    <h2>Sửa sản phẩm</h2>

    <form method="post" enctype="multipart/form-data" class="add-form">

        <!-- NAME -->
        <div class="form-group">
            <label>Tên sản phẩm</label>
            <input type="text" class="form-control-long" value="PC Gaming i5 Gen 12" />
        </div>

        <!-- CATEGORY -->
        <div class="form-group">
            <label>Danh mục</label>
            <select class="form-control">
                <option>Combo PC</option>
                <option selected>Linh kiện rời</option>
                <option>Phụ kiện PC</option>
                <option>Thiết bị mạng</option>
                <option>Thiết bị ngoại vi</option>
            </select>
        </div>

        <!-- PRICE -->
        <div class="form-group">
            <label>Giá tiền</label>
            <input type="number" class="form-control" value="15000000" />
        </div>

        <!-- DISCOUNT -->
        <div class="form-group">
            <label>Giảm giá (%)</label>
            <input type="number" class="form-control" value="10" />
        </div>

        <!-- PERFORMANCE -->
        <div class="form-group">
            <label>Hiệu suất</label>
            <input type="text" class="form-control-long" value="Mạnh" />
        </div>

        <!-- DESCRIPTION -->
        <div class="form-group">
            <label>Mô tả</label>
            <textarea class="form-control-long" rows="4">Máy tính chơi game cấu hình mạnh...</textarea>
        </div>

        <!-- IMAGE UPLOAD -->
        <div class="form-group">
            <label>Ảnh sản phẩm</label>
            <input type="file" accept="image/*" class="form-control"
                   onchange="previewImage(event)" />

            <div class="image-preview-box">
                <img id="preview"
                     src="/images/sample.jpg"
                     style="display:block" />
            </div>
        </div>

        <button type="submit" class="btn-submit">Cập nhật sản phẩm</button>
    </form>
</div>

<!-- JS PREVIEW -->
<script>
    function previewImage(event) {
        const img = document.getElementById("preview");
        img.src = URL.createObjectURL(event.target.files[0]);
        img.style.display = "block";
    }
</script>

<style>
    .add-container {
        background: #fff;
        padding: 25px;
        width: 750px;
        margin: 20px auto;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    h2 {
        margin-bottom: 20px;
        font-weight: 700;
    }

    .add-form .form-group {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
    }

    .form-control {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        width: 300px;
    }

    .form-control-long {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    .btn-submit {
        padding: 10px 18px;
        background: #ee4d2d;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
    }

    .image-preview-box {
        margin-top: 10px;
    }

    #preview {
        width: 150px;
        border-radius: 6px;
        margin-top: 10px;
        display: none;
    }
</style>

