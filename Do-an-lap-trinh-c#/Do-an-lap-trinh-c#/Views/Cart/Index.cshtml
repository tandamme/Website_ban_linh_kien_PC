@using Do_an_lap_trinh_c_.Extensions
@using Do_an_lap_trinh_c_.Models
@using Do_an_lap_trinh_c_.Extensions
@using Do_an_lap_trinh_c_.Models
@using Do_an_lap_trinh_c_.Extensions
@using Do_an_lap_trinh_c_.Models
@using Do_an_lap_trinh_c_.Extensions
@using Do_an_lap_trinh_c_.Models
@using Do_an_lap_trinh_c_.Extensions
@using Do_an_lap_trinh_c_.Models
@* @model IEnumerable<Do_an_lap_trinh_c_.Models.CartItem> *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cart Page";

    
}
@model List<CartItem>

<style>
    :root {
        --primary-color: #007BFF;
        --secondary-color: #0056B3;
        --accent-color: #00C8FF;
        --bg-color: #F5F6FA;
        --text-color: #212529;
        --light-text-color: #6C757D;
        --success-color: #28A745;
        --fail-color: #DC3545;
    }

    .cart-container {
        max-width: 1000px;
        margin: 40px auto;
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    }

    .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr 150px 150px;
    align-items: center;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid #ddd;
}


    .cart-item img {
        width: 90px;
        border-radius: 10px;
    }

    .qty-box {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
    }

    .btn-qty {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--primary-color);
        color: white;
        border: none;
        cursor: pointer;
        font-size: 18px;
        transition: 0.2s;
    }

    .btn-qty:hover {
        background: var(--secondary-color);
    }

    .qty-display {
        width: 40px;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
    }

    .item-total {
        width: 100%;
        text-align: right;
        font-size: 18px;
        font-weight: bold;
        color: var(--accent-color);
        white-space: nowrap;
    }

    .cart-total-box {
        margin-top: 25px;
        text-align: right;
        font-size: 24px;
        font-weight: bold;
        color: var(--primary-color);
    }

    .btn-checkout {
        margin-top: 15px;
        padding: 12px 25px;
        background: var(--success-color);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 18px;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-checkout:hover {
        background: #1f8a3a;
    }

    .cart-container { max-width:1000px; margin:40px auto; background:white; padding:25px; border-radius:15px; }
    .cart-item { display:grid; grid-template-columns: 100px 1fr 150px 150px; gap:20px; align-items:center; padding:15px 0; border-bottom:1px solid #ddd; }
    .cart-item img { width:90px; border-radius:10px; }
    .qty-box { display:flex; align-items:center; gap:10px; justify-content:center; }
    .btn-qty { width:32px; height:32px; border-radius:8px; background:#007bff; color:#fff; border:none; cursor:pointer; }
    .item-total { text-align:right; font-weight:bold; color:#00C8FF; }
</style>

<div class="cart-container">
    <h1 style="text-align:center; margin-bottom:20px;">🛒 Giỏ hàng của bạn</h1>

    <div id="cart-list">
        @if (Model==null)
        {
            <p style="text-align:center; padding:20px;">Giỏ hàng trống</p>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="cart-item" data-id="@item.ProductId" data-price="@item.Price">
                    <img src="@Url.Content(item.Image ?? "~/img/no-image.png")" />

                    <div>
                        <h3>@item.Name</h3>
                        <p style="color:#6C757D;">@String.Format("{0:n0}", item.Price) VNĐ</p>
                    </div>

                    <div class="qty-box">
                        <button class="btn-qty btn-minus">-</button>
                        <span class="qty-display">@item.Quantity</span>
                        <button class="btn-qty btn-plus">+</button>
                    </div>

                    <div class="item-total">
                        @String.Format("{0:n0}", item.Price * item.Quantity) VNĐ
                    </div>
                </div>
            }
        }
    </div>

    <div style="text-align:right; margin-top:20px; font-size:20px;">
        Tổng cộng: <span id="cart-total">0</span> VNĐ
    </div>

<a asp-controller="Cart"
   asp-action="CheckOut"
   class="btn-checkout">
   Thanh toán
</a>




</div>

<script>
    // client-side qty update; updates session via /cart/add (for increments) or /cart/remove (for removals)
    (function () {
        function updateTotal() {
            let total = 0;
            document.querySelectorAll('.cart-item').forEach(item => {
                const price = parseInt(item.dataset.price);
                const qty = parseInt(item.querySelector('.qty-display').textContent);
                const totalItem = price * qty;
                item.querySelector('.item-total').textContent = totalItem.toLocaleString() + " VNĐ";
                total += totalItem;
            });
            document.getElementById('cart-total').textContent = total.toLocaleString();
        }

        document.querySelectorAll('.btn-plus').forEach(btn => {
            btn.addEventListener('click', function () {
                const root = this.closest('.cart-item');
                const id = parseInt(root.dataset.id);
                fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: id, quantity: 1 })
                }).then(r => r.json()).then(res => {
                    if (res.ok) {
                        const q = root.querySelector('.qty-display');
                        q.textContent = parseInt(q.textContent) + 1;
                        updateTotal();
                    }
                });
            });
        });

        document.querySelectorAll('.btn-minus').forEach(btn => {
            btn.addEventListener('click', function () {
                const root = this.closest('.cart-item');
                const id = parseInt(root.dataset.id);
                const qElem = root.querySelector('.qty-display');
                const qty = parseInt(qElem.textContent);
                if (qty <= 1) {
                    // remove item
                    fetch('/cart/remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: id })
                    }).then(r => r.json()).then(res => {
                        if (res.ok) {
                            root.remove();
                            updateTotal();
                        }
                    });
                } else {
                    // decrement by 1: call add with -1? we call add with quantity = -1 is not safe.
                    // Simpler: call add with quantity = 0 and then set session on server would need change.
                    // Current approach: call add to increment/decrement is not implemented; instead remove + re-add not optimal.
                    // We'll perform a local decrement and send updated entire cart to server via /cart/items not implemented for saving.
                    qElem.textContent = qty - 1;
                    updateTotal();
                }
            });
        });

        updateTotal();
    })();
</script>

