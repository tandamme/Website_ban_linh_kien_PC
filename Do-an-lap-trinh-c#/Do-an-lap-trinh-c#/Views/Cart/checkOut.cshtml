

@model List<CartItem>

@{
    var list = Model ?? new List<CartItem>();
    decimal grandTotal = list.Sum(x => x.Total);
}




<style>
    .checkout-container {
        max-width: 1100px;
        margin: 30px auto;
        padding: 20px;
        background: var(--bg-color);
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .checkout-title {
        text-align: center;
        font-size: 36px;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 25px;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 30px;
    }

    .checkout-box {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 3px 6px rgba(0,0,0,0.08);
    }

    .product-item {
        display: flex;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #ddd;
    }

    .product-item:last-child {
        border-bottom: none;
    }

    .product-img {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        object-fit: cover;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 18px;
    }

    .summary-total {
        font-size: 22px;
        font-weight: 700;
        color: var(--secondary-color);
    }

    .checkout-btn {
        width: 100%;
        padding: 14px;
        font-size: 20px;
        background: var(--primary-color);
        color: white;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: 0.3s;
    }

    .checkout-btn:hover {
        background: var(--secondary-color);
        transform: scale(1.02);
    }
</style>

<div class="checkout-container">
    <h1 class="checkout-title">Checkout</h1>

    <div class="checkout-grid">
        <!-- LEFT: Product List -->
        <div class="checkout-box">
            <h3 style="margin-bottom:15px;">Sản phẩm của bạn</h3>

            @foreach (var item in Model)
            {
                <div class="product-item">
                    <img src="@item.Image" class="product-img" />

                    <div style="flex:1;">
                        <h4>@item.Name</h4>
                        <p>Giá: @item.Price.ToString("#,##0")đ</p>
                        <p>Số lượng: @item.Quantity</p>
                    </div>

                    <div style="text-align:right; font-weight:600;">
                        @item.Total.ToString("#,##0")đ
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Summary + Customer Info -->
        <div class="checkout-box">
            <h3>Thông tin thanh toán</h3>

            <div class="summary-row">
                <span>Tạm tính:</span>
                <span>@grandTotal.ToString("#,##0")đ</span>
            </div>

            <div class="summary-row">
                <span>Phí vận chuyển:</span>
                <span>0đ</span>
            </div>

            <div class="summary-row summary-total">
                <span>Tổng thanh toán:</span>
                <span>@grandTotal.ToString("#,##0")đ</span>
            </div>

            <hr />

            <form method="post" asp-controller="Order" asp-action="PlaceOrder">
                <label>Họ và tên</label>
                <input type="text" name="FullName" class="form-control" required />

                <label style="margin-top:10px;">Email</label>
                <input type="email" name="Email" class="form-control" required />

                <label style="margin-top:10px;">Số điện thoại</label>
                <input type="text" name="Phone" class="form-control" required />

                <label style="margin-top:10px;">Địa chỉ nhận hàng</label>
                <textarea name="Address" class="form-control" required></textarea>

                <label style="margin-top:15px; font-weight:600;">Phương thức thanh toán</label>

                    <div style="margin-top:10px;">
                        <label style="display:flex; align-items:center; gap:6px;">
                            <input type="radio" name="PaymentMethod" value="COD" checked />
                            Thanh toán khi nhận hàng (COD)
                        </label>

                        <label style="display:flex; align-items:center; gap:6px; margin-top:8px;">
                            <input type="radio" name="PaymentMethod" value="VNPay" />
                            Thanh toán qua VNPay
                        </label>

                        <label style="display:flex; align-items:center; gap:6px; margin-top:8px;">
                            <input type="radio" name="PaymentMethod" value="Banking" />
                            Chuyển khoản ngân hàng
                        </label>
                    </div>
                <button class="checkout-btn" type="submit" style="margin-top:15px;">
                    Thanh toán ngay
                </button>
            </form>
        </div>
    </div>
</div>

