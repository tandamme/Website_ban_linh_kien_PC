@{
    ViewData["Title"] = "Order Success";
}

<style>
    .success-container {
        max-width: 700px;
        margin: 40px auto;
        padding: 35px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0px 6px 18px rgba(0,0,0,0.12);
        text-align: center;
        animation: fadeIn 0.8s ease;
    }

    .success-icon {
        font-size: 90px;
        color: var(--success-color);
        margin-bottom: 15px;
    }

    .success-title {
        font-size: 34px;
        font-weight: 800;
        color: var(--primary-color);
        margin-bottom: 10px;
    }

    .success-message {
        font-size: 19px;
        color: var(--text-color);
        margin-bottom: 20px;
    }

    .success-info {
        background: var(--bg-color);
        padding: 18px;
        border-radius: 12px;
        margin-bottom: 25px;
        text-align: left;
        font-size: 18px;
    }

    .success-btn {
        padding: 13px 23px;
        background: var(--primary-color);
        color: white;
        font-size: 20px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: 0.3s;
    }

    .success-btn:hover {
        background: var(--secondary-color);
        transform: scale(1.03);
    }
</style>

<div class="success-container">
    <i class='bx bx-check-circle success-icon'></i>

    <div class="success-title">Đặt hàng thành công!</div>

    <div class="success-message">
        Cảm ơn bạn đã mua hàng tại <strong>PC Master</strong>.  
        Chúng tôi đã nhận được đơn của bạn.
    </div>

    <div class="success-info">
       <p><strong>Khách hàng:</strong> @TempData["FullName"]</p>
<p><strong>Email:</strong> @TempData["Email"]</p>
<p><strong>Phương thức thanh toán:</strong> @TempData["PaymentMethod"]</p>

    </div>

    <a href="/Home/Home" class="success-btn">Tiếp tục mua sắm</a>
</div>

