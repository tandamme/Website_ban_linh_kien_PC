@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br>
<br>

<div class="user-container">
    <h2>Quản lý tài khoản người dùng</h2>

    <!-- Thanh tìm kiếm -->
    <div class="user-top-bar">
        <input type="text" class="user-search" placeholder="Tìm kiếm người dùng...">
        <button class="btn-add" onclick="openAddPopup()">+ Thêm người dùng</button>
    </div>

    <!-- Bảng danh sách -->
    <table class="user-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên người dùng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            <!-- Demo -->
            <tr>
                <td>1</td>
                <td>Admin</td>
                <td>admin@gmail.com</td>
                <td>Quản trị viên</td>
                <td>2024-01-01</td>
                <td>
                    <button class="btn-edit" onclick="openEditPopup()">Edit</button>
                    <button class="btn-delete" onclick="openDeletePopup()">Delete</button>
                </td>
            </tr>

            <tr>
                <td>2</td>
                <td>Will</td>
                <td>user@gmail.com</td>
                <td>Khách hàng</td>
                <td>2024-03-18</td>
                <td>
                    <button class="btn-edit" onclick="openEditPopup()">Edit</button>
                    <button class="btn-delete" onclick="openDeletePopup()">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- ---------------------------------------------------- -->
<!-- POPUP: ADD USER -->
<!-- ---------------------------------------------------- -->
<div class="popup-background" id="addPopup">
    <div class="popup-box">
        <h3>Thêm người dùng</h3>

        <label>Tên người dùng</label>
        <input type="text" class="popup-input">

        <label>Email</label>
        <input type="email" class="popup-input">

        <label>Mật khẩu</label>
        <input type="password" class="popup-input">

        <label>Vai trò</label>
        <select class="popup-input">
            <option>Khách hàng</option>
            <option>Quản trị viên</option>
        </select>

        <div class="popup-actions">
            <button class="btn-cancel" onclick="closePopup()">Hủy</button>
            <button class="btn-save">Lưu</button>
        </div>
    </div>
</div>

<!-- ---------------------------------------------------- -->
<!-- POPUP: EDIT USER -->
<!-- ---------------------------------------------------- -->
<div class="popup-background" id="editPopup">
    <div class="popup-box">
        <h3>Chỉnh sửa người dùng</h3>

        <label>Tên người dùng</label>
        <input type="text" class="popup-input">

        <label>Email</label>
        <input type="email" class="popup-input">

        <label>Vai trò</label>
        <select class="popup-input">
            <option>Khách hàng</option>
            <option>Quản trị viên</option>
        </select>

        <div class="popup-actions">
            <button class="btn-cancel" onclick="closePopup()">Hủy</button>
            <button class="btn-save">Cập nhật</button>
        </div>
    </div>
</div>

<!-- ---------------------------------------------------- -->
<!-- POPUP: DELETE CONFIRM -->
<!-- ---------------------------------------------------- -->
<div class="popup-background" id="deletePopup">
    <div class="popup-box small">
        <h3>Bạn có chắc muốn xóa?</h3>

        <div class="popup-actions">
            <button class="btn-cancel" onclick="closePopup()">Hủy</button>
            <button class="btn-delete">Xóa</button>
        </div>
    </div>
</div>

@section Styles {
<style>
    .user-container {
        padding: 20px 40px;
    }

    .user-top-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .user-search {
        width: 300px;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .btn-add {
        background: #28a745;
        border: none;
        padding: 8px 14px;
        color: #fff;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
    }

    .user-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .user-table th, .user-table td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
        text-align: left;
    }

    .btn-edit, .btn-delete {
        padding: 6px 10px;
        border-radius: 4px;
        border: none;
        color: #fff;
        font-size: 13px;
        cursor: pointer;
    }

    .btn-edit { background: #007bff; }
    .btn-edit:hover { background: #0069d9; }

    .btn-delete { background: #dc3545; }
    .btn-delete:hover { background: #c82333; }

    /* Popup */
    .popup-background {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    .popup-box {
        background: #fff;
        padding: 20px;
        width: 350px;
        border-radius: 10px;
        animation: fadeIn 0.25s ease;
    }

    .popup-box.small {
        width: 280px;
        text-align: center;
    }

    .popup-input {
        width: 100%;
        padding: 8px 10px;
        margin-bottom: 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .popup-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-cancel {
        padding: 7px 14px;
        background: #777;
        color: white;
        border: none;
        border-radius: 5px;
    }

    .btn-save {
        padding: 7px 14px;
        background: #17a2b8;
        color: white;
        border: none;
        border-radius: 5px;
    }
</style>
}

@section Scripts {
<script>
    function openAddPopup() {
        document.getElementById("addPopup").style.display = "flex";
    }

    function openEditPopup() {
        document.getElementById("editPopup").style.display = "flex";
    }

    function openDeletePopup() {
        document.getElementById("deletePopup").style.display = "flex";
    }

    function closePopup() {
        document.querySelectorAll(".popup-background").forEach(p => p.style.display = "none");
    }
</script>
}

