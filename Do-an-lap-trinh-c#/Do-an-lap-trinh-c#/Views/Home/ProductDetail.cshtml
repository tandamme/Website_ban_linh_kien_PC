@model Do_an_lap_trinh_c_.Data.Product
@{
    Layout = "_Layout";
    ViewData["Title"] = "Product Detail";

    var product = Model;
    string priceFormatted = (product?.DonGia ?? 0).ToString("N0");
    string category = product?.MaLoaiNavigation?.TenLoai ?? "Unknown";
    string desc = string.IsNullOrEmpty(product?.MoTaChiTiet) ? product?.MoTaTomTat ?? "" : product?.MoTaChiTiet ?? "";

}

@section Styles {
    <link rel="stylesheet" href="~/css/style1.css" />
    <style>
        .product-detail { display:flex; flex-wrap:wrap; gap:40px; margin:20px 0; justify-content:center; }
        .product-detail img { max-width:400px; width:100%; border-radius:8px; }
        .product-info { max-width:600px; display:flex; flex-direction:column; gap:10px; }
        .product-info h1 { font-size:32px; margin-bottom:10px; }
        .product-info h2 { color:#ff0000; margin:5px 0; }
        .product-info span, .product-info p { display:block; margin:5px 0; line-height:1.5; }
        .back-btn { margin-top:20px; display:inline-block; text-decoration:none; color:#fff; background:#333; padding:10px 20px; border-radius:5px; transition:0.3s; }
        .back-btn:hover { background:#555; color:#fff; }
    </style>
}

@if (product == null)
{
    <h2>Không tìm thấy sản phẩm!</h2>
    <a href="@Url.Action("Product", "Home")" class="back-btn">Quay lại danh sách sản phẩm</a>
}
else
{
    <section class="product-detail">
         <img src="~/images/san_pham/@product.Hinh"/>
        <div class="product-info">
            <h1>@product.TenSanPham</h1>
            <h2>@priceFormatted VNĐ</h2>
            @if (!string.IsNullOrEmpty(desc))
            {
                @desc
            }
            <span><strong>Danh mục:</strong> @category</span>
            @if (product.NgayTao != null)
            {
                <span><strong>Ngày sản xuất:</strong> @product.NgayTao</span>
            }
             <!-- SỐ LƯỢNG -->
        <div class="qty-wrapper">
         <span>Số lượng:</span>
         <div class="qty-control">
            <button onclick="changeQty(-1)">−</button>
            <input id="qty" type="text" value="1" readonly>
             <button onclick="changeQty(1)">+</button>
         </div>
         </div>

        <!-- BUTTON -->
        <div class="action-box">
    <button class="btn-add" onclick="addToCart(@product.MaSanPham)">
        <i class="bx bx-cart"></i> Thêm vào giỏ
    </button>

    <button class="btn-buy" onclick="buyNow(@product.MaSanPham)">
        <i class="bx bx-credit-card"></i> Thanh toán ngay
    </button>
</div>
    </section>
}
<style>
 .qty-wrapper{
    margin:15px 0;
}

.qty-control{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:5px;
}

.qty-control button{
    width:38px;
    height:38px;
    border:none;
    background:#222;
    color:#fff;
    border-radius:8px;
    font-size:18px;
    cursor:pointer;
    transition:.2s;
}

.qty-control button:hover{
    background:#000;
}

.qty-control input{
    width:55px;
    height:38px;
    text-align:center;
    font-size:16px;
    border:1px solid #ccc;
    border-radius:6px;
}

/* BUTTON */
.action-box{
    display:flex;
    gap:15px;
    margin-top:20px;
}

.btn-add{
    padding:12px 22px;
    background:linear-gradient(135deg,#0d6efd,#0b5ed7);
    color:white;
    border:none;
    border-radius:10px;
    font-size:16px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:8px;
    box-shadow:0 4px 12px rgba(13,110,253,.4);
}

.btn-buy{
    padding:12px 22px;
    background:linear-gradient(135deg,#dc3545,#b02a37);
    color:white;
    border:none;
    border-radius:10px;
    font-size:16px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:8px;
    box-shadow:0 4px 12px rgba(220,53,69,.4);
}

.btn-add:hover{ transform:translateY(-1px); }
.btn-buy:hover{ transform:translateY(-1px); }

    </style>
<script src="~/js/site.js"></script>
<script>
let qty = 1;

function changeQty(val){
    qty += val;
    if(qty < 1) qty = 1;
    document.getElementById("qty").value = qty;
}
</script>

<script>
function addToCart(id){
    let quantity = document.getElementById("qty").value;

    fetch('/cart/add',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
            productId:id,
            quantity: parseInt(quantity)
        })
    })
    .then(r=>r.json())
    .then(res=>{
        if(res.ok){
            alert("Đã thêm " + quantity + " sản phẩm!");
        }
    });
}
</script>
