@*
  Application layout for Razor Pages.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style1.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" />
    @* Link Swiper's CSS *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
.LogoLeft {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 10px;
    transition: 0.3s ease;
}

.LogoLeft i {
    font-size: 42px;
    color: var(--accent-color);
    text-shadow: 0 0 8px rgba(0, 200, 255, 0.4);
}

.LogoLeft span {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--primary-color);
}

.LogoLeft:hover {
    transform: scale(1.06);
    background: rgba(0, 123, 255, 0.12);
}

.LogoLeft:hover span {
    color: var(--secondary-color);
}

.LogoLeft:hover i {
    color: var(--primary-color);
    text-shadow: 0 0 10px rgba(0, 123, 255, 0.6);
}

.profile {
    display: flex;
    align-items: center;
    column-gap: 0.5rem;
    cursor: pointer;
    position: relative; /* Phải có */
}

.profile-dropdown {
    position: absolute;
   top: 100%;
    right: 0;
    width: 150px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.2);
    list-style: none;
    padding: 8px 0;
    display: none;
    z-index: 2000;
}

    .profile-dropdown li {
        padding: 10px 15px;
    }

        .profile-dropdown li a {
            color: #333;
            text-decoration: none;
            display: block;
        }

        .profile-dropdown li:hover {
            background: #f2f2f2;
        }

        .profile-dropdown.active {
            display: block;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <header>
        <a asp-controller="Home" asp-action="Home" class="LogoLeft">
            <i class='bx bx-microchip'></i>
            <span>PC MASTER</span>
        </a>
           <!-- Menu Icon-->
        <div class="bx bx-menu" id="menu-icon"></div>
        <!-- Nav List-->
        <ul class="navbar">
            <li>
                <a asp-controller="Home" asp-action="Home"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Home" ? "home-active" : "")">
                    Home
                </a>
            </li>

            <li>
                <a asp-controller="Home" asp-action="Product"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Product" ? "home-active" : "")">
                    Product
                </a>
            </li>

           <li>
                <a asp-controller="Home" asp-action="Notification"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Notification" ? "home-active" : "")">
                    Notification
                </a>
            </li>

             <li>
                <a asp-controller="Home" asp-action="AboutUs"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "AboutUs" ? "home-active" : "")">
                    About us
                </a>
            </li>

            <li>
                <a asp-controller="Home" asp-action="ContactUs"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ContactUs" ? "home-active" : "")">
                    Contact us
                </a>
            </li>
       </ul>

        <!-- Profile -->
        @{
    var username = Context.Session.GetString("USERNAME");
}

@if (string.IsNullOrEmpty(username))
{
    <!-- CHƯA LOGIN -->
    <a asp-controller="Home" asp-action="Login" class="btn-login">
        <i class='bx bx-user'></i> Đăng nhập
    </a>
}
else
{
    <!-- ĐÃ LOGIN -->
    <div class="profile" id="profileMenu">
        <img src="~/img/pfp.webp" alt="" />
        <span>@username</span>
        <i class='bx bx-caret-down'></i>

        <ul class="profile-dropdown" id="profileDropdown">
            <li><a asp-controller="Home" asp-action="ProductManagement">Admin</a></li>
            <li>
                <a asp-controller="Home" asp-action="Logout">
                    Đăng xuất
                </a>
            </li>
        </ul>
    </div>
}

        

        <!-- Cart -->
        <a asp-controller="Cart" asp-action="Index" class="cart">
     <i class='bx bx-shopping-bag'></i>
            <span class="cart-quantity"></span>
        </a>

        
    </header>
   
    

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <section class="footer" id="footer">
        <div class="footer-box">
           <a asp-controller="Home" asp-action="Home" class="LogoLeft">
                <i class='bx bx-microchip'></i>
                <span>PC MASTER</span>
           </a>
            <p>PC Master, 23/34 khu phố 13 <br>phường Hố Nai, Biên Hòa, Đồng Nai</p>
            <div class="social">
                <a href="#"><i class='bx bxl-facebook'></i></a>
                <a href="#"><i class='bx bxl-instagram'></i></a>
                <a href="#"><i class='bx bxl-twitter'></i></a>
                <a href="#"><i class='bx bxl-linkedin'></i></a>
            </div>
        </div>
        <div class="footer-box">
            <h2>Category</h2>
            <a href="#">Combo PC</a>
            <a href="#">Linh kiện rời</a>
            <a href="#">Thiết bị ngoại vi</a>
            <a href="#">Thiết bị mạng</a>
            <a href="#">Phụ kiện PC</a>
        </div>

        <div class="footer-box">
            <h2>Useful Link</h2>
            <a href="#">Payment & Tax</a>
            <a href="#">Điều khoản</a>
            <a href="#">Blog</a>
            <a href="#">Hoàn trả</a>
        </div>

        <div class="footer-box">
            <h2>Newsletter</h2>
            <p>Đăng ký để nhận thông tin mới nhất từ chúng tôi</p>
            <form action="">
                <i class='bx bxs-envelope'></i>
                <input type="email" name="" id="" placeholder="Nhập email của bạn" />
                <i class='bx bx-arrow-back bx-rotate-180'></i>
            </form>
        </div>
    </section>

    <!-- Copy right -->
    <div class="copyright">
        <p>© 2024 PC Master. All rights reserved.</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        const profileMenu = document.getElementById("profileMenu");
        const dropdown = document.getElementById("profileDropdown");

        profileMenu.addEventListener("click", function () {
            dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
        });

        // Ẩn dropdown khi click ra ngoài
        document.addEventListener("click", function (event) {
            if (!profileMenu.contains(event.target)) {
                dropdown.style.display = "none";
            }
        });
</script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
